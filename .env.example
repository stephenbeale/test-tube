# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback (plus your production URL).
# Enable "YouTube Data API v3" and "YouTube Analytics API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies and encrypts stored OAuth tokens. `openssl rand -base64 32`
APP_SECRET=

# Public origin of the app; only needed when it differs from the request origin.
# APP_URL=https://testtube.example.com

# Defaults to a local SQLite file. For production use a libSQL/Turso database.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Bearer token required by /api/cron/sync (Vercel Cron sends it automatically).
CRON_SECRET=
